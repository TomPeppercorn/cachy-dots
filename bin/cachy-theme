    on_acc = readable_on(p["accent"], p["bg"], p["fg"])
    write(CFG / "walker/themes/cachy/style.css", f"""/* Generated by cachy-theme ({p['name']}) — edits here are overwritten. */
* {{ all: unset; font-family: "{FONT_UI}", sans-serif; }}

.box-wrapper {{
  background: {p['surface']};
  color: {p['fg']};
  border: 2px solid {p['accent']};
  border-radius: 14px;
  padding: 14px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
}}

.search-container {{
  background: {p['overlay']};
  border-radius: 10px;
  padding: 8px 12px;
  margin-bottom: 8px;
}}

.input {{ color: {p['fg']}; caret-color: {p['accent']}; }}
.input placeholder, .placeholder, .elephant-hint {{ color: {p['muted']}; }}
.input selection {{ background: {p['accent']}; color: {on_acc}; }}

.list {{ color: {p['fg']}; }}
.item-box {{ padding: 6px 10px; border-radius: 8px; }}
.item-subtext {{ color: {p['muted']}; font-size: 0.85em; }}
.item-quick-activation {{ color: {p['muted']}; }}
child:selected .item-box, row:selected .item-box {{ background: {p['overlay']}; }}
child:selected .item-text-box, row:selected .item-text-box {{ color: {p['accent']}; }}

.normal-icons {{ -gtk-icon-size: 18px; }}
.large-icons {{ -gtk-icon-size: 32px; }}

.preview {{ border-left: 1px solid {p['border']}; padding-left: 10px; color: {p['fg']}; }}
.keybinds {{ color: {p['muted']}; padding-top: 6px; }}
.keybind-bind {{ color: {p['accent']}; }}
.error {{ color: {p['red']}; }}
scrollbar {{ opacity: 0; }}
popover {{ background: {p['overlay']}; border: 1px solid {p['border']}; border-radius: 10px; padding: 8px; }}
""")


def r_pacsea(p):
    """Pacsea (Super+Alt+P) reads ~/.config/pacsea/theme.conf on start and needs all 16 keys."""
    dark = p["variant"] == "dark"
    crust = mix(p["bg"], "#000000", 0.25 if dark else 0.06)
    keys = {
        "background_base": p["surface"], "background_mantle": p["bg"], "background_crust": crust,
        "surface_level1": p["overlay"], "surface_level2": p["border"],
        "overlay_primary": p["muted"], "overlay_secondary": mix(p["muted"], p["fg"], 0.3),
        "text_primary": p["fg"], "text_secondary": mix(p["fg"], p["muted"], 0.35),
        "text_tertiary": mix(p["fg"], p["muted"], 0.2),
        "accent_interactive": p["blue"], "accent_heading": p["accent"], "accent_emphasis": p["accent2"],
        "semantic_success": p["green"], "semantic_warning": p["yellow"], "semantic_error": p["red"],
    }
    body = "\n".join(f"{k} = {v}" for k, v in keys.items())
    write(CFG / "pacsea/theme.conf", f"# Generated by cachy-theme ({p['name']}) — edits here are overwritten\n{body}\n")


RENDERERS = [r_quickshell, r_kitty, r_hyprland, r_gtk, r_hyprlock, r_swaync, r_btop, r_vicinae, r_walker, r_pacsea]


# ── reload running apps ──────────────────────────────────────────
def in_session():
    return bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or os.environ.get("WAYLAND_DISPLAY"))


def reload_all(p):
    gsettings_apply(p)
    if not in_session():
        return
    run("pkill", "-USR1", "-x", "kitty")          # kitty re-reads its config
    run("hyprctl", "reload")
    run("swaync-client", "--reload-css")
    if subprocess.run(["pgrep", "-x", "walker"], capture_output=True).returncode == 0:
        run("pkill", "-x", "walker")              # Walker caches CSS in its service
        spawn("walker", "--gapplication-service")
    # Quickshell and Vicinae watch their files and update by themselves.


def restart_wallpaper():
    if not in_session() or current_wallpaper() is None:
        return
    run("pkill", "-x", "swaybg")
    spawn("swaybg", "-m", "fill", "-i", str(WALLPAPER_LINK))


# ── commands ─────────────────────────────────────────────────────
def resolve_palette(st):
    if st.get("theme") == "wallpaper":
        wp = current_wallpaper()
        if wp is None:
            die("no wallpaper set — run: cachy-theme wallpaper <image>")
        return matugen_palette(wp, st.get("wallpaper_variant", "dark"))
    ps = presets()
    if st.get("theme") not in ps:
        if not ps:
            die(f"no themes found in {THEMES}")
        st["theme"] = "gruvbox-dark" if "gruvbox-dark" in ps else next(iter(ps))
    return ps[st["theme"]]


def apply(reload=True):
    st = load_state()
    p = resolve_palette(st)
    for r in RENDERERS:
        try:
            r(p)
        except Exception as e:  # one broken target shouldn't block the rest
            print(f"cachy-theme: {r.__name__[2:]} skipped: {e}", file=sys.stderr)
    save_state(st)
    if reload:
        reload_all(p)
    else:
        gsettings_apply(p)
    return p


def cmd_set(tid):
    st = load_state()
    if tid != "wallpaper" and tid not in presets():
        die(f"unknown theme '{tid}'. Try: cachy-theme list")
    st["theme"] = tid
    if tid != "wallpaper":
        st["variant"] = presets()[tid].get("variant", "dark")
    save_state(st)
    p = apply()
    notify(f"Theme: {p['name']}")


def cmd_wallpaper(path):
    img = Path(path).expanduser().resolve()
    if not img.is_file():
        die(f"not a file: {img}")
    CD.mkdir(parents=True, exist_ok=True)
    if WALLPAPER_LINK.is_symlink() or WALLPAPER_LINK.exists():
        WALLPAPER_LINK.unlink()
    WALLPAPER_LINK.symlink_to(img)
    st = load_state()
    st["wallpaper"] = str(img)
    save_state(st)
    restart_wallpaper()
    if st.get("theme") == "wallpaper":
        apply()
        notify("Wallpaper + colors updated")


def notify(msg):
    if in_session():
        run("notify-send", "-a", "cachy-theme", "-i", "preferences-desktop-theme", msg)
    print(msg)


def launcher_menu(lines, prompt):
    exe = shutil.which("cachy-launcher") or str(HOME / ".local/bin/cachy-launcher")
    r = subprocess.run([exe, "dmenu", prompt], input="\n".join(lines), capture_output=True, text=True)
    return r.stdout.strip()


def cmd_list(as_json):
    ps = presets()
    st = load_state()
    if as_json:
        items = [{"id": k, "name": v.get("name", k), "variant": v.get("variant", "dark"),
                  "colors": [v[c] for c in ("surface", "accent", "accent2", "red", "green", "blue")],
                  "active": st.get("theme") == k} for k, v in ps.items()]
        items.append({"id": "wallpaper", "name": "From wallpaper", "variant": st.get("wallpaper_variant", "dark"),
                      "colors": [], "active": st.get("theme") == "wallpaper"})
        print(json.dumps(items))
        return
    for k, v in ps.items():
        print(f"{'*' if st.get('theme') == k else ' '} {k:<18} {v.get('name', k)}")
    print(f"{'*' if st.get('theme') == 'wallpaper' else ' '} {'wallpaper':<18} Colors from your wallpaper")


def cmd_pick():
    ps = presets()
    labels = {f"{v.get('name', k)}": k for k, v in ps.items()}
    labels["From wallpaper"] = "wallpaper"
    choice = launcher_menu(list(labels), "Theme")
    if choice in labels:
        cmd_set(labels[choice])


def cmd_pick_wallpaper():
    imgs = []
    for d in WALLPAPER_DIRS:
        if d.is_dir():
            imgs += sorted(str(f) for f in d.rglob("*") if f.suffix.lower() in IMAGE_EXT)
    if not imgs:
        die("no images in ~/Pictures/Wallpapers or ~/.config/cachy-dots/wallpapers")
    choice = launcher_menu(imgs, "Wallpaper")
    if choice:
        cmd_wallpaper(choice)


def main(argv):
    if not argv:
        st = load_state()
        print(f"theme: {st.get('theme')}  wallpaper: {current_wallpaper()}")
        return
    cmd, rest = argv[0], argv[1:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
    elif cmd == "list":
        cmd_list("--json" in rest)
    elif cmd == "set" and rest:
        cmd_set(rest[0])
    elif cmd == "wallpaper" and rest:
        cmd_wallpaper(rest[0])
    elif cmd == "pick":
        cmd_pick()
    elif cmd == "pick-wallpaper":
        cmd_pick_wallpaper()
    elif cmd == "apply":
        apply(reload="--no-reload" not in rest)
    elif cmd == "variant" and rest and rest[0] in ("dark", "light"):
        st = load_state(); st["wallpaper_variant"] = rest[0]; save_state(st); apply()
    else:
        die("unknown command. See: cachy-theme --help")


if __name__ == "__main__":
    main(sys.argv[1:])
