#!/usr/bin/env bash
# cachy-dots · the SDDM login screen (SilentSDDM, neutral look)
#
#   cachy-login-theme        put your current wallpaper on the login screen now
#   cachy-login-theme off    stop following your wallpaper (the login screen keeps its last image)
#   cachy-login-theme on     follow your wallpaper again (the default)
#
# Changing your wallpaper (Super+Shift+W) already updates the login screen; this is for doing it
# by hand, or turning that off.
set -uo pipefail

helper=/usr/local/libexec/cachy-login-wallpaper
state="${XDG_CONFIG_HOME:-$HOME/.config}/cachy-dots/state.json"
say() { notify-send -a "Login screen" "$1" "${2:-}" 2>/dev/null; echo "$1${2:+ — $2}"; }

set_sync() {
    [[ -f "$state" ]] || echo '{}' > "$state"
    tmp="$(mktemp)" && jq --argjson v "$1" '.login_sync = $v' "$state" > "$tmp" && mv "$tmp" "$state"
}

case "${1:-}" in
    off) set_sync false; say "Login screen stays as it is" "Turn following back on with: cachy-login-theme on"; exit 0 ;;
    on)  set_sync true ;;
    "")  ;;
    *)   echo "usage: cachy-login-theme [on|off]" >&2; exit 1 ;;
esac

[[ -x "$helper" && -f /usr/share/sddm/themes/silent/metadata.desktop ]] \
    || { say "The SDDM login theme isn't installed" "Re-run the cachy-dots installer."; exit 1; }
wall="$(readlink -f "${XDG_CONFIG_HOME:-$HOME/.config}/cachy-dots/wallpaper" 2>/dev/null)"
[[ -f "$wall" ]] || { say "No wallpaper set yet" "Pick one with Super+Shift+W."; exit 1; }

if pkexec "$helper" < "$wall" >/dev/null; then
    say "Login screen updated" "You'll see $(basename "$wall") next time you log in."
else
    say "Couldn't update the login screen" "Try: sudo $helper < '$wall'"
    exit 1
fi
