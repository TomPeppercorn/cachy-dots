#!/usr/bin/env bash
# cachy-dots · change the SDDM login screen's style
#
# Lists the astronaut theme's styles, plus "Match my desktop", which copies your current
# cachy-theme colors and wallpaper onto the login screen. Asks for your password (pkexec)
# because the login screen's files live outside your home folder.
set -uo pipefail

dir=/usr/share/sddm/themes/sddm-astronaut-theme
meta="$dir/metadata.desktop"
say() { notify-send -a "Login screen" "$1" "${2:-}" 2>/dev/null; echo "$1 ${2:-}"; }

[[ -f "$meta" ]] || { say "The SDDM theme isn't installed" "Re-run the cachy-dots installer."; exit 1; }

mapfile -t styles < <(find "$dir/Themes" -name '*.conf' ! -name 'cachy.conf' -printf '%f\n' | sed 's/\.conf$//' | sort)
match="Match my desktop (current theme + wallpaper)"
choice="$( { echo "$match"; printf '%s\n' "${styles[@]}"; } | "$HOME/.local/bin/cachy-launcher" dmenu "Login screen style")"
[[ -z "$choice" ]] && exit 0

if [[ "$choice" == "$match" ]]; then
    pal="$HOME/.config/cachy-dots/palette.json"
    wall="$(readlink -f "$HOME/.config/cachy-dots/wallpaper")"
    [[ -f "$pal" && -f "$wall" ]] || { say "No theme or wallpaper set yet" "Run cachy-theme first."; exit 1; }
    c() { jq -r ".$1" "$pal"; }
    ext="${wall##*.}"
    tmp="$(mktemp -d)"
    sed -E \
        -e "s|^Background=.*|Background=\"Backgrounds/cachy-wallpaper.$ext\"|" \
        -e "s@^(HeaderTextColor|DateTextColor|TimeTextColor)=.*@\1=\"$(c fg)\"@" \
        -e "s|^BackgroundColor=.*|BackgroundColor=\"$(c surface)\"|" \
        -e "s|^LoginButtonBackgroundColor=.*|LoginButtonBackgroundColor=\"$(c accent)\"|" \
        -e "s|^HighlightBackgroundColor=.*|HighlightBackgroundColor=\"$(c overlay)\"|" \
        -e "s|^Font=.*|Font=\"IBM Plex Sans\"|" \
        "$dir/Themes/astronaut.conf" > "$tmp/cachy.conf"
    cp "$wall" "$tmp/wall.$ext"
    pkexec /bin/sh -c "install -m644 '$tmp/cachy.conf' '$dir/Themes/cachy.conf' \
        && install -m644 '$tmp/wall.$ext' '$dir/Backgrounds/cachy-wallpaper.$ext' \
        && sed -i 's|^ConfigFile=.*|ConfigFile=Themes/cachy.conf|' '$meta'" \
        && say "Login screen now matches your desktop" "You'll see it next time you log in."
    rm -rf "$tmp"
else
    pkexec sed -i "s|^ConfigFile=.*|ConfigFile=Themes/$choice.conf|" "$meta" \
        && say "Login screen style: $choice" "You'll see it next time you log in."
fi
